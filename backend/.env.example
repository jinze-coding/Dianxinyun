# Copy values into the deployment platform's secret/environment settings.
# Spring Boot does not load this file automatically. Never commit a filled copy.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FORWARD_HEADERS_STRATEGY=NATIVE

DB_URL=jdbc:mysql://db.example.internal:3306/dianxinyun?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY
DB_USERNAME=site_platform
DB_PASSWORD=replace-with-database-secret

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-secret
REDIS_DATABASE=0

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MILLIS=604800000

# Independent key for AES-GCM encrypted visitor phone numbers, identity cards and invite tokens.
VISITOR_DATA_ENCRYPTION_KEY=replace-with-a-different-at-least-32-byte-random-secret
# Independent key for AES-GCM encrypted seal QR scenes. Never reuse the visitor/JWT key.
SEAL_SCENE_ENCRYPTION_KEY=replace-with-another-at-least-32-byte-random-secret

WECHAT_MINI_PROGRAM_APP_ID=replace-with-official-app-id
WECHAT_MINI_PROGRAM_APP_SECRET=replace-with-wechat-secret
WECHAT_MINI_PROGRAM_MOCK_ENABLED=false
WECHAT_MINI_PROGRAM_PRODUCTION=true
WECHAT_MINI_PROGRAM_LEGAL_DOMAIN=https://api.example.com
WECHAT_MINI_PROGRAM_PUBLIC_FALLBACK_URL=https://app.example.com/scan

KNIFE4J_ENABLE=false
API_DOCS_ENABLED=false
SWAGGER_UI_ENABLED=false

FILE_STORAGE_TYPE=minio
MINIO_ENDPOINT=https://minio.example.internal
MINIO_BUCKET=site-platform
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# One-time administrator recovery only. Do not leave these values configured.
# ADMIN_RESET_USERNAME=
# ADMIN_RESET_PASSWORD=
