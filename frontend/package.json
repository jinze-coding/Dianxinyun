{
  "name": "telecom-cloud-platform",
  "version": "1.0.0",
  "description": "电信云平台项目现场综合管理系统",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "VITE_API_BASE_URL=/api/v1 vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
